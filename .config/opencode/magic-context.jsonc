{
  "$schema": "https://raw.githubusercontent.com/cortexkit/opencode-magic-context/master/assets/magic-context.schema.json",
  "historian": {
    "model": "openai/gpt-5.4"
  },
  "dreamer": {
    "model": "openai/gpt-5.4",
    "schedule": "00:00-06:00",
    "pin_key_files": {
      "enabled": false
    }
  },
  "sidekick": {
    "model": "openai/gpt-5.4"
  },
  "execute_threshold_tokens": {
    "default": 120000,
    "openai/gpt-5.3-codex": 120000,
    "openai/gpt-5.4": 120000,
    "openai/gpt-5.5-fast": 120000
  }
}
