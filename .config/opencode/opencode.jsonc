{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "openTelemetry": false,
  },
  "tools": {
    "websearch": true,
    "codesearch": true,
  },
  "plugin": [
    "cc-safety-net",
    "@cortexkit/opencode-magic-context@latest",
    "oh-my-opencode-slim",
    "superpowers@git+https://github.com/obra/superpowers.git",
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "plan-agent",
        "planningAgents": ["plan", "orchestrator"],
      },
    ],
    "./plugins/caveman/plugin.js",

    // "@cortexkit/aft-opencode@latest"
  ],
  "mcp": {
    // "caveman-shrink": {
    //   "type": "local",
    //   "command": ["npx", "-y", "caveman-shrink"],
    //   "enabled": true,
    // },
    "zotero": {
      "type": "local",
      "command": ["zotero-mcp", "serve"],
      "enabled": false,
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": false,
    },
    "github": {
      "type": "remote",
      "url": "https://github.com/github/github-mcp-server#local-github-mcp-server",
      "enabled": false,
    },
  },
  "agent": {
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
  },
  "lsp": true,
  "compaction": {
    "auto": false,
    "prune": false,
  },
}
